rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function emailLower() {
      return request.auth.token.email.lower();
    }

    function isMember() {
      return isVerified()
        && exists(/databases/$(database)/documents/miembros/$(emailLower()));
    }

    function isAdmin() {
      return isVerified()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /lugares/{id} {
      allow read: if true;
      allow create: if isMember()
        && request.resource.data.autorUid == request.auth.uid;
      allow update, delete: if isMember() && (
        isAdmin()
        || (resource.data.autorUid is string
            && resource.data.autorUid.size() > 0
            && resource.data.autorUid == request.auth.uid)
      );
    }

    match /registros/{id} {
      allow read: if true;
      allow create: if isMember()
        && request.resource.data.autorUid == request.auth.uid;
      allow update, delete: if isMember() && (
        isAdmin()
        || (resource.data.autorUid is string
            && resource.data.autorUid.size() > 0
            && resource.data.autorUid == request.auth.uid)
      );
    }

    // Notas: públicas legibles por todos; privadas solo autor o admin
    match /notas/{id} {
      allow read: if resource.data.visibilidad == 'publica'
        || (isSignedIn() && resource.data.autorUid == request.auth.uid)
        || isAdmin();
      allow create: if isMember()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 2000;
      allow update, delete: if isMember() && (
        isAdmin()
        || resource.data.autorUid == request.auth.uid
      );
    }

    match /ocultos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /miembros/{email} {
      allow read: if isSignedIn() && emailLower() == email;
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if isVerified() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
