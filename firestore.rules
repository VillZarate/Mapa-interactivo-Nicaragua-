rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Mapa: todos leen; cualquier cuenta verificada escribe lo suyo; admin todo
    match /lugares/{id} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.autorUid == request.auth.uid;
      allow update, delete: if isVerified() && (
        isAdmin()
        || resource.data.autorUid == request.auth.uid
      );
    }

    match /registros/{id} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.autorUid == request.auth.uid;
      allow update, delete: if isVerified() && (
        isAdmin()
        || resource.data.autorUid == request.auth.uid
        // migrados sin dueño: solo admin
        || (isAdmin() && (!(resource.data.autorUid is string) || resource.data.autorUid.size() == 0))
      );
    }

    match /notas/{id} {
      allow read: if resource.data.visibilidad == 'publica'
        || (isSignedIn() && resource.data.autorUid == request.auth.uid)
        || isAdmin();
      allow create: if isVerified()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 2000;
      allow update, delete: if isVerified() && (
        isAdmin() || resource.data.autorUid == request.auth.uid
      );
    }

    match /ocultos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Solo lectura del propio doc de admin (se crea a mano en la consola)
    match /admins/{uid} {
      allow read: if isVerified() && request.auth.uid == uid;
      allow write: if false;
    }

    // Colección miembros ya no se usa para permisos (se deja bloqueada)
    match /miembros/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
